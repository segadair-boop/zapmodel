NODE_ENV=production
PORT=8080
FRONTEND_URL=https://zapmodel.lovable.app

# Lovable Cloud (nunca use service_role nem DATABASE_URL aqui)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Conta técnica usada pelas tarefas em segundo plano do WhatsApp
